# Copy to .env.local and fill in. Never commit real values.

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# AI generation: primary provider (cloudflare | gemini); the other is the automatic fallback.
AI_PROVIDER=cloudflare
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional: alerts for AI failures / fallbacks and auth errors
DISCORD_WEBHOOK_URL=
