{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run md2slides VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension", "${workspaceFolder}/vscode-extension/sample"],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "vscode:dev-build"
    }
  ]
}
